{
  "version": "0.2.0",
  "configurations": [
    // 빌드 → TAG 를 붙여 앱을 쓰고(build-flash) → 리셋 → 부트로더가 앱으로 점프 → 앱 main 에서 멈춘다.
    //   loadFiles 를 비워 디버거가 ELF 를 다시 쓰지 않게 한다. 디버거가 쓰면 앱 첫 섹터(TAG 가 든 8 KB)를
    //   지워 TAG 가 사라지고, 부트로더가 앱으로 가지 않는다. 심볼은 executable 에서 읽는다.
    //   부트로더 코드는 심볼이 없어 단계 실행이 안 된다 (부트로더는 stm32h5-boot 의 Debug Boot).
    {
      "name": "Debug FW",
      "cwd": "${workspaceRoot}",
      "executable": "./build/stm32h5-fw.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "stlink",
      "serverArgs": [
        "-m",
        "1"
      ],
      "loadFiles": [],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "preLaunchTask": "build-flash",
      "osx": {
        "serverpath": "${userHome}/ST/STM32CubeCLT/STLink-gdb-server/bin/ST-LINK_gdbserver",
        "stm32cubeprogrammer": "${userHome}/ST/STM32CubeCLT/STM32CubeProgrammer/bin",
        "svdFile": "${userHome}/ST/STM32CubeCLT/STMicroelectronics_CMSIS_SVD/STM32H563.svd"
      },
      "windows": {
        "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
        "stm32cubeprogrammer": "${env:STM32CLT_PATH}/STM32CubeProgrammer/bin",
        "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H563.svd"
      }
    },
    // TAG 를 붙여 앱을 쓰고(태스크 flash-stlink) 리셋한 뒤, 부트로더가 실행한 앱에 붙는다 (리셋 없이 attach).
    //   launch 로 하면 디버거가 리셋 후 부트로더부터 돌리고, ELF 만 쓰면 TAG 가 맞지 않아 앱으로 가지 않는다.
    //   flash-stlink 는 빌드를 하지 않는다. 빌드는 build-build 로 먼저 한다.
    {
      "name": "Flash + Attach FW",
      "cwd": "${workspaceRoot}",
      "executable": "./build/stm32h5-fw.elf",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "stlink",
      "serverArgs": [
        "-m",
        "1"
      ],
      "showDevDebugOutput": "none",
      "preLaunchTask": "flash-stlink",
      "osx": {
        "serverpath": "${userHome}/ST/STM32CubeCLT/STLink-gdb-server/bin/ST-LINK_gdbserver",
        "stm32cubeprogrammer": "${userHome}/ST/STM32CubeCLT/STM32CubeProgrammer/bin",
        "svdFile": "${userHome}/ST/STM32CubeCLT/STMicroelectronics_CMSIS_SVD/STM32H563.svd"
      },
      "windows": {
        "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
        "stm32cubeprogrammer": "${env:STM32CLT_PATH}/STM32CubeProgrammer/bin",
        "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H563.svd"
      }
    },
    // 지금 돌고 있는 앱에 붙기만 한다. 쓰기는 하지 않는다.
    // executable 은 심볼용이다. 보드에서 돌고 있는 앱과 같은 ELF 여야 한다.
    {
      "name": "Attach FW",
      "cwd": "${workspaceRoot}",
      "executable": "./build/stm32h5-fw.elf",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "stlink",
      "serverArgs": [
        "-m",
        "1"
      ],
      "showDevDebugOutput": "none",
      "osx": {
        "serverpath": "${userHome}/ST/STM32CubeCLT/STLink-gdb-server/bin/ST-LINK_gdbserver",
        "stm32cubeprogrammer": "${userHome}/ST/STM32CubeCLT/STM32CubeProgrammer/bin",
        "svdFile": "${userHome}/ST/STM32CubeCLT/STMicroelectronics_CMSIS_SVD/STM32H563.svd"
      },
      "windows": {
        "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
        "stm32cubeprogrammer": "${env:STM32CLT_PATH}/STM32CubeProgrammer/bin",
        "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H563.svd"
      }
    }
  ]
}
