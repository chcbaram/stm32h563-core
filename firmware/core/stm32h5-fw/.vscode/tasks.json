{
  "version": "2.0.0",
  "tasks": [
    {
      // 구성과 빌드를 ; 로 잇는다 (&& 는 PowerShell 5.1 에서 안 된다).
      //   -j20 은 코어 수를 덮는 상수다. 숫자 없는 -j 는 make 에서 "제한 없음" 이라 쓰지 않는다.
      //   Windows 는 MinGW make 로 빌드한다 (기본 생성기는 Visual Studio 라 지정해야 한다).
      "label": "build-build",
      "type": "shell",
      "command": "cmake -S . -B build; cmake --build build -j20",
      "windows": { "command": "cmake -S . -B build -G 'MinGW Makefiles'; cmake --build build -j20" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-clean",
      "type": "shell",
      "command": "cmake --build build --target clean",
      "problemMatcher": []
    },
    {
      // ST-LINK(SWD) 로 앱을 쓰고 리셋한다. TAG 는 PC 에서 계산해 이미지 앞에 붙인다 (0x08040000).
      //   TAG 가 없으면 부트로더가 앱을 실행하지 않는다. 빌드는 하지 않는다.
      "label": "flash-stlink",
      "type": "shell",
      "command": "python3 tools/flash.py --target fw",
      "windows": { "command": "python tools/flash.py --target fw" },
      "problemMatcher": []
    },
    {
      // 빌드한 뒤 SWD 로 쓴다 (런치 Debug FW 의 preLaunchTask)
      "label": "build-flash",
      "dependsOrder": "sequence",
      "dependsOn": ["build-build", "flash-stlink"],
      "problemMatcher": []
    },
    {
      // UART(ST-LINK VCP) 로 앱을 내려받고 실행한다. 앱이 돌고 있으면 부트로더로 넘긴 뒤 쓴다.
      //   baram-term 이 포트를 열고 있으면 잠시 놓게 한다. 빌드는 하지 않는다.
      "label": "download-uart",
      "type": "shell",
      "command": "python3 tools/download.py",
      "windows": { "command": "python tools/download.py" },
      "problemMatcher": []
    },
    {
      // 포트를 직접 고른다 (Firmware Task Manager 확장이 목록을 띄운다)
      "label": "download-uart (포트 선택)",
      "type": "shell",
      "command": "python3 tools/download.py --port ${input:uartPort}",
      "windows": { "command": "python tools/download.py --port ${input:uartPort}" },
      "problemMatcher": []
    },
    {
      // USB CDC 로 내려받는다 (921600 으로 연다. 터미널이 그 포트를 열고 있으면 못 연다)
      "label": "download-cdc",
      "type": "shell",
      "command": "python3 tools/download.py --via cdc",
      "windows": { "command": "python tools/download.py --via cdc" },
      "problemMatcher": []
    },
    {
      // USB HID 로 내려받는다. 터미널이 CDC 를 CLI 로 쓰는 중에도 된다 (hidapi 필요)
      "label": "download-hid",
      "type": "shell",
      "command": "python3 tools/download.py --via hid",
      "windows": { "command": "python tools/download.py --via hid" },
      "problemMatcher": []
    },
    {
      "label": "device-reset",
      "type": "shell",
      "command": "${userHome}/ST/STM32CubeCLT/STM32CubeProgrammer/bin/STM32_Programmer_CLI -c port=SWD mode=UR -rst",
      "windows": { "command": "& '${env:STM32CLT_PATH}/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe' -c port=SWD mode=UR -rst" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "uartPort",
      "type": "command",
      "command": "firmware-task.pickSerialPort",
      "args": {
        "placeholder": "ST-LINK VCP (CLI 포트) 를 고른다",
        "filter": "usbmodem|ttyACM|COM"
      }
    }
  ]
}
